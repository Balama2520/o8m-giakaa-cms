# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=5000
NODE_ENV=development

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
# Secret key used to sign and verify administrative JWT tokens (generate a strong random string)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=8h

# CORS Whitelist (comma-separated origins allowed to make API requests)
CORS_ORIGIN=http://localhost:5173,https://o8m-giakaa-cms.vercel.app

# Canonical public site URL for XML sitemap generation
SITE_URL=https://o8m-giakaa-cms.vercel.app

# ==============================================================================
# MONGODB CONFIGURATION (Blogs, Admin Users)
# ==============================================================================
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/giakaa_cms?retryWrites=true&w=majority

# ==============================================================================
# POSTGRESQL CONFIGURATION (Hero Slides)
# ==============================================================================
# Primary connection string (recommended for hosted PostgreSQL like Supabase, Render, Neon)
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require

# Individual connection fields (used as fallback if DATABASE_URL is omitted)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==============================================================================
# INITIAL ADMIN PROVISIONING (Used by scripts/createAdmin.js)
# ==============================================================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@giakaa.com
ADMIN_PASSWORD=your_secure_admin_password_min_8_chars
